# === Redis ===
REDIS_HOST=localhost           # 'redis' when running via docker-compose
REDIS_PORT=6379
REDIS_PASSWORD=                # set in production

# === API Server ===
PORT=3000
NODE_ENV=development           # 'production' in Docker

# === Worker ===
WORKER_ID_PREFIX=worker        # distinguishes instances in logs/dashboard (e.g. worker-1, worker-2)
WORKER_CONCURRENCY=3           # jobs this worker processes simultaneously

# === Dashboard ===
# No env vars needed — the built app uses relative URLs (/api/v1, same-origin
# WebSocket). Vite's dev proxy handles /api -> localhost:3000 in development;
# nginx handles /api -> api-server:3000 in the Docker build.
