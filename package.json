{
  "name": "distributed-task-queue",
  "version": "1.0.0",
  "private": true,
  "description": "A production-grade distributed task queue and job scheduler with a real-time monitoring dashboard, built with Express, BullMQ, Redis, and React.",
  "author": "Ashish Kumar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ashishayu100/Distributed-Task-Queue"
  },
  "keywords": [
    "task-queue",
    "job-scheduler",
    "distributed-systems",
    "bullmq",
    "redis",
    "websocket",
    "real-time",
    "docker"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=api-server",
    "dev:worker": "npm run dev --workspace=worker",
    "dev:worker:2": "cross-env WORKER_ID_PREFIX=worker-2 npm run dev --workspace=worker",
    "dev:dashboard": "npm run dev --workspace=dashboard",
    "dev:all": "concurrently \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:dashboard\"",
    "build": "npm run build --workspace=shared && npm run build --workspace=api-server && npm run build --workspace=worker && npm run build --workspace=dashboard",

    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build",
    "docker:start": "docker-compose up --build -d",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:logs:api": "docker-compose logs -f api-server",
    "docker:logs:worker": "docker-compose logs -f worker-1 worker-2",
    "docker:logs:dashboard": "docker-compose logs -f dashboard",
    "docker:ps": "docker-compose ps",
    "docker:restart": "docker-compose restart",
    "docker:clean": "docker-compose down -v --rmi local",

    "docker:dev": "docker-compose -f docker-compose.dev.yml up --build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "typescript": "^5.5.4"
  }
}
